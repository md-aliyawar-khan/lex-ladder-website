# Server
PORT=3000

# Where contact form emails are delivered (your inbox)
CONTACT_TO=you@yourdomain.com

# SMTP — works with Gmail (App Password), Outlook, Zoho, your host, SendGrid SMTP, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be an address your SMTP provider allows as From (often same as SMTP_USER)
SMTP_FROM=you@yourdomain.com

# Optional: if the website is on another origin (e.g. static on Netlify, API on Render)
# CORS_ORIGIN=https://www.yourdomain.com
